# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
dist/
# build/ catches PyInstaller work output, but the source files
# for the bundled build (PyInstaller spec + AppImage resources)
# live under build/ too and MUST be tracked. Ignore everything
# under build/ by default, then explicitly un-ignore the tracked
# source files.
build/*
!build/axross.spec
!build/axross.desktop
!build/axross.svg
# The hashed dependency lock of the bundles: osv-scanner skips ignored files.
!build/requirements-bundle.in
!build/requirements-bundle.txt
!build/requirements-bootstrap.txt
# The rest of what scripts/build_dist.sh reads from a clean `git archive`
# (the CI builder has nothing else): the build's and the scanners' locks,
# the target systems' package lists, the reviewed young-release exceptions,
# capa's pinned rules, the standalone tools' spec.
!build/requirements-dist-tools.in
!build/requirements-dist-tools.txt
!build/requirements-scan-tools.in
!build/requirements-scan-tools.txt
!build/sysroot/
!build/young-release-exceptions.txt
!build/capa-rules.txt
!build/capa-sigs.txt
!build/standalone.spec
build-tmp/
*.whl

# Virtual environments
.venv/
.venv2/
venv/
env/

# Scanner / tooling artifacts — output is ephemeral, regenerated
# by security/run_analysis.sh, never committed.
.scan-reports/
.scan-reports-v2/
security/reports/
security/scanner_reports/
security/security/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Testing
.pytest_cache/
htmlcov/
.coverage
# SQLite's ``:memory:`` marker used to be materialised as a real file
# because ``sqlite_fs_client.py`` ran it through ``os.path.abspath``.
# Fixed — the magic name is now passed through untouched. The ignore
# stays as a backstop so a regression cannot dirty a worktree-clean
# gate unnoticed.
/:memory:

# OAuth tokens (sensitive)
*_token.json

.env
.env.*
*.key
*.pem
*.pfx
*.p12
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
*.pcap
*.pcapng
:memory:
