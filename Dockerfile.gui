# axross with its GUI, for podman (or docker) on a Wayland or X11 desktop.
#
# The desktop app, the MCP server and the Agent dock in one image; run it
# with scripts/axross-podman.sh, which hands the container the display
# socket of the host (Wayland, else X11 with a cookie of its own), a home
# kept between runs and, with --llm-model, a llama.cpp server beside it
# in one pod:
#
#   scripts/axross-podman.sh build
#   scripts/axross-podman.sh gui
#   scripts/axross-podman.sh gui --llm-model ~/models/qwen2.5-7b-instruct-q4_k_m.gguf
#   scripts/axross-podman.sh mcp -- --mcp-tools remote,agent
#
# Only the wheel enters the final image, never the source tree.

FROM docker.io/library/python:3.12-slim-bookworm AS wheel

WORKDIR /src
COPY . .
RUN pip wheel --no-cache-dir --no-deps --wheel-dir /wheels .

FROM docker.io/library/python:3.12-slim-bookworm

# Qt's two Linux desktop platforms: xcb (X11) and wayland, plus OpenGL,
# fonts and D-Bus. The check after the install proves the list complete.
# openssh-client and rsync: the backends that call those programs.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libegl1 libgl1 libglib2.0-0 libfontconfig1 libfreetype6 libdbus-1-3 \
        libx11-6 libx11-xcb1 libxcb1 libxcb-cursor0 libxcb-icccm4 libxcb-image0 \
        libxcb-keysyms1 libxcb-randr0 libxcb-render0 libxcb-render-util0 \
        libxcb-shape0 libxcb-shm0 libxcb-sync1 libxcb-util1 libxcb-xfixes0 \
        libxcb-xkb1 libxkbcommon0 libxkbcommon-x11-0 \
        libwayland-client0 libwayland-cursor0 libwayland-egl1 \
        fonts-dejavu-core ca-certificates openssh-client rsync \
    && rm -rf /var/lib/apt/lists/*

COPY --from=wheel /wheels /wheels
RUN pip install --no-cache-dir "$(ls /wheels/axross-*.whl)[all]" && rm -rf /wheels

# Fail the build when a Qt platform plugin misses a library: every
# library the xcb and wayland plugins (and Wayland's shell integrations)
# load must resolve.
RUN set -e; \
    qt=$(python -c "import PyQt6, os; print(os.path.join(os.path.dirname(PyQt6.__file__), 'Qt6'))"); \
    missing=0; \
    for lib in "$qt"/plugins/platforms/libqxcb.so "$qt"/plugins/platforms/libqwayland*.so \
               "$qt"/plugins/wayland-shell-integration/*.so "$qt"/plugins/xcbglintegrations/*.so; do \
        if LD_LIBRARY_PATH="$qt/lib" ldd "$lib" | grep "not found"; then echo "missing for $lib"; missing=1; fi; \
    done; \
    exit $missing

RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin axross
USER axross
WORKDIR ~
ENV HOME=~ \
    LANG=C.UTF-8 \
    XDG_RUNTIME_DIR=/tmp/runtime-axross \
    QT_QPA_PLATFORM=xcb

# Qt wants a private runtime directory; the one of the host stays outside.
ENTRYPOINT ["sh", "-c", "mkdir -p -m 700 \"$XDG_RUNTIME_DIR\" && exec axross \"$@\"", "axross"]
