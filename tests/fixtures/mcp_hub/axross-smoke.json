{
 "schema": "axross-mcp-hub-smoke",
 "version": 1,
 "comment": "Smoke spec of every catalog entry, read by axross's tests and by scripts/axross_smoke.py (format in its docstring). Files are self-made fixtures (no third-party samples, no malware); ${TARGET_HOST}/${TARGET_PORT} are where the runner published the target. Every server must also offer exactly the tools of servers/<name>/tools.json.",
 "targets": {
  "web": {
   "image": "docker.io/library/python",
   "digest": "sha256:0b566a9f30a60730df33c26ac62dedb55393d8814645cd03543b67bf8987f3a1",
   "port": 8080,
   "command": [
    "python3",
    "-I",
    "/srv/app.py"
   ],
   "files": [
    {
     "target": "/srv",
     "path": "app.py",
     "base64": ""
    }
   ],
   "source": "tests/web_target/app.py",
   "serves": "HTTP/1.0 on port 8080 (python:3.14-slim, tests/web_target/app.py): / HTML index linking /item?id=1; /item?id=N SQLite lookup built by string concatenation (SQL-injectable on purpose, for sqlmap); /admin 200; /robots.txt Disallow: /admin; everything else 404; Server: hubtest/1.0, no security headers (for nuclei). Publish it only on a host-only address."
  }
 },
 "servers": [
  {
   "name": "binwalk",
   "tools_required": [
    "binwalk_scan",
    "binwalk_extract",
    "binwalk_entropy"
   ],
   "files": [
    {
     "target": "/work",
     "path": "firmware.bin",
     "base64": "",
     "gzip": true
    }
   ],
   "network": "none",
   "call": {
    "tool": "binwalk_scan",
    "args": {
     "filepath": "/work/firmware.bin"
    },
    "expect_substring": "Zip archive data"
   },
   "refused": {
    "tool": "binwalk_scan",
    "args": {
     "filepath": "/etc/passwd"
    },
    "expect_substring": "only paths under /work"
   },
   "timeout_s": 180
  },
  {
   "name": "capa",
   "tools_required": [
    "capa_analyze",
    "get_analysis_results"
   ],
   "files": [
    {
     "target": "/work",
     "path": "caps",
     "base64": "",
     "gzip": true
    }
   ],
   "network": "none",
   "call": {
    "tool": "capa_analyze",
    "args": {
     "filepath": "/work/caps"
    },
    "expect_substring": "act as TCP client"
   },
   "refused": {
    "tool": "capa_analyze",
    "args": {
     "filepath": "/etc/passwd"
    },
    "expect_substring": "only paths under /work"
   },
   "timeout_s": 900
  },
  {
   "name": "crtsh",
   "tools_required": [
    "ct_search",
    "ct_certificate"
   ],
   "network": {
    "allowlist": [
     "crt.sh:443"
    ]
   },
   "live_needs_network": true,
   "call": {
    "tool": "ct_search",
    "args": {
     "domain": "example.com",
     "include_subdomains": false,
     "max_certificates": 5
    },
    "expect_substring": "\"domain\":"
   },
   "refused": {
    "tool": "ct_search",
    "args": {
     "domain": "--help"
    },
    "expect_substring": "domain: a domain name"
   },
   "timeout_s": 240,
   "notes": "crt.sh is a public service (passive CT search); it is sometimes overloaded, then the call fails with 'crt.sh answered HTTP 5xx' or 'did not answer JSON' - retry before treating it as a regression."
  },
  {
   "name": "dnstwist",
   "tools_required": [
    "dnstwist_permutations",
    "dnstwist_scan",
    "dnstwist_fuzzers"
   ],
   "network": "none",
   "call": {
    "tool": "dnstwist_permutations",
    "args": {
     "domain": "example.com",
     "fuzzers": [
      "omission"
     ]
    },
    "expect_substring": "exmple.com"
   },
   "refused": {
    "tool": "dnstwist_permutations",
    "args": {
     "domain": "--help"
    },
    "expect_substring": "domain: a domain name"
   },
   "timeout_s": 120
  },
  {
   "name": "exiftool",
   "tools_required": [
    "read_metadata",
    "list_supported_formats"
   ],
   "files": [
    {
     "target": "/work",
     "path": "photo.png",
     "base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAAGXRFWHRBdXRob3IATUNQSFVCLVRFU1QtTUFSS0VSVos3LQAAADJ0RVh0Q29tbWVudABjcmVhdGVkIGZvciB0aGUgYXhyb3NzLW1jcC1odWIgc21va2UgdGVzdHOw6lZRAAAADElEQVR4nGP4z8AAAAMBAQDJ/pLvAAAAAElFTkSuQmCC"
    }
   ],
   "network": "none",
   "call": {
    "tool": "read_metadata",
    "args": {
     "file_path": "/work/photo.png",
     "tags": [
      "Author"
     ]
    },
    "expect_substring": "MCPHUB-TEST-MARKER"
   },
   "refused": {
    "tool": "read_metadata",
    "args": {
     "file_path": "/etc/passwd"
    },
    "expect_substring": "only files under /work"
   },
   "timeout_s": 120
  },
  {
   "name": "ffuf",
   "tools_required": [
    "ffuf_dir",
    "ffuf_custom",
    "list_wordlists"
   ],
   "network": "full",
   "target": "web",
   "call": {
    "tool": "ffuf_dir",
    "args": {
     "url": "http://${TARGET_HOST}:${TARGET_PORT}/FUZZ",
     "wordlist": "common",
     "threads": 10
    },
    "expect_substring": "\"input\": \"admin\""
   },
   "refused": {
    "tool": "ffuf_custom",
    "args": {
     "url": "http://${TARGET_HOST}:${TARGET_PORT}/FUZZ",
     "wordlist": "/etc/passwd"
    },
    "expect_substring": "wordlist: one of"
   },
   "timeout_s": 300
  },
  {
   "name": "floss",
   "tools_required": [
    "floss_strings",
    "floss_languages"
   ],
   "files": [
    {
     "target": "/work",
     "path": "stack.exe",
     "base64": "",
     "gzip": true
    }
   ],
   "network": "none",
   "call": {
    "tool": "floss_strings",
    "args": {
     "filepath": "/work/stack.exe",
     "only": [
      "stack",
      "tight"
     ]
    },
    "expect_substring": "MCPHUB-STACK-MARKER"
   },
   "refused": {
    "tool": "floss_strings",
    "args": {
     "filepath": "/work/stack.exe",
     "only": [
      "--version"
     ]
    },
    "expect_substring": "only: a list"
   },
   "timeout_s": 600
  },
  {
   "name": "gitleaks",
   "tools_required": [
    "scan_directory",
    "scan_git_history",
    "list_rules"
   ],
   "files": [
    {
     "target": "/work",
     "path": "leaky.env",
     "base64": "ZXhwb3J0IEdJVEhVQl9UT0tFTj0iZ2hwX1E3d0VyVDV5VWk5b1BhMnNEZjRnSGo2a0x6OHhDdjFiTm0zTSIK"
    }
   ],
   "network": "none",
   "call": {
    "tool": "scan_directory",
    "args": {
     "path": "/work/leaky.env"
    },
    "expect_substring": "github-pat"
   },
   "refused": {
    "tool": "scan_directory",
    "args": {
     "path": "/etc"
    },
    "expect_substring": "only paths under /work"
   },
   "timeout_s": 180
  },
  {
   "name": "john",
   "tools_required": [
    "crack",
    "extract_hash",
    "list_formats"
   ],
   "files": [
    {
     "target": "/work",
     "path": "secret.zip",
     "base64": "UEsDBAoACQAAADJ+WV2rmzcZJgAAABoAAAAJABwAaW5uZXIudHh0VVQJAAMQJd5qECXeanV4CwABBAAAAAAEAAAAAGBCx3eiZbdiGxMvbz4KVlQoZtFOQwTNcbhNp/yyLFH9zEVuXpHbUEsHCKubNxkmAAAAGgAAAFBLAQIeAwoACQAAADJ+WV2rmzcZJgAAABoAAAAJABgAAAAAAAEAAACkgQAAAABpbm5lci50eHRVVAUAAxAl3mp1eAsAAQQAAAAABAAAAABQSwUGAAAAAAEAAQBPAAAAeQAAAAAA"
    }
   ],
   "network": "none",
   "setup": [
    {
     "tool": "extract_hash",
     "args": {
      "kind": "zip",
      "filepath": "/work/secret.zip"
     }
    }
   ],
   "call": {
    "tool": "crack",
    "args": {
     "hashes": [
      "2ab96390c7dbe3439de74d0c9b0b1767"
     ],
     "format": "raw-md5",
     "max_seconds": 60
    },
    "expect_substring": "hunter2"
   },
   "refused": {
    "tool": "crack",
    "args": {
     "hashes": [
      "x"
     ],
     "format": "dynamic=md5($p)"
    },
    "expect_substring": "format: a john format"
   },
   "timeout_s": 240
  },
  {
   "name": "mcpcap",
   "tools_required": [
    "analyze_dns_packets",
    "analyze_capinfos",
    "analyze_icmp_packets"
   ],
   "files": [
    {
     "target": "/work",
     "path": "sample.pcap",
     "base64": ""
    }
   ],
   "network": "none",
   "call": {
    "tool": "analyze_dns_packets",
    "args": {
     "pcap_file": "/work/sample.pcap"
    },
    "expect_substring": "mcphub-test.example"
   },
   "refused": {
    "tool": "analyze_dns_packets",
    "args": {
     "pcap_file": "/etc/passwd"
    },
    "expect_substring": "is not a supported PCAP file"
   },
   "timeout_s": 120
  },
  {
   "name": "nmap",
   "tools_required": [
    "port_scan",
    "service_scan",
    "quick_scan"
   ],
   "network": "full",
   "target": "web",
   "call": {
    "tool": "port_scan",
    "args": {
     "target": "${TARGET_HOST}",
     "ports": "${TARGET_PORT}"
    },
    "expect_substring": "\"port\": \"${TARGET_PORT}\""
   },
   "refused": {
    "tool": "port_scan",
    "args": {
     "target": "--script=x",
     "ports": "80"
    },
    "expect_substring": "Error: target:"
   },
   "timeout_s": 240
  },
  {
   "name": "nuclei",
   "tools_required": [
    "nuclei_scan",
    "template_scan",
    "list_templates"
   ],
   "network": "full",
   "target": "web",
   "call": {
    "tool": "template_scan",
    "args": {
     "target": "http://${TARGET_HOST}:${TARGET_PORT}/",
     "templates": [
      "misconfiguration"
     ],
     "severity": [
      "info"
     ]
    },
    "expect_substring": "http-missing-security-headers"
   },
   "refused": {
    "tool": "nuclei_scan",
    "args": {
     "target": "-u http://x",
     "tags": [
      "tech"
     ]
    },
    "expect_substring": "Error: target:"
   },
   "timeout_s": 900
  },
  {
   "name": "radare2",
   "tools_required": [
    "open_file",
    "analyze",
    "list_functions",
    "decompile_function"
   ],
   "files": [
    {
     "target": "/work",
     "path": "hello",
     "base64": "",
     "gzip": true
    }
   ],
   "network": "none",
   "setup": [
    {
     "tool": "open_file",
     "args": {
      "file_path": "/work/hello"
     }
    },
    {
     "tool": "analyze",
     "args": {
      "level": 2
     }
    }
   ],
   "call": {
    "tool": "decompile_function",
    "args": {
     "address": "sym.check_password"
    },
    "expect_substring": "hunter2"
   },
   "refused": {
    "tool": "open_file",
    "args": {
     "file_path": "/etc/passwd"
    },
    "expect_substring": "Failed to open file"
   },
   "timeout_s": 300
  },
  {
