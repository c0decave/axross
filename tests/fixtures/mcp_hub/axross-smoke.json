     "fields": [
      "frame.number",
      "-e"
     ]
    },
    "expect_substring": "fields: up to 40"
   },
   "timeout_s": 120
  },
  {
   "name": "yara",
   "tools_required": [
    "yara_scan",
    "yara_scan_with_rules",
    "list_rulesets"
   ],
   "files": [
    {
     "target": "/work",
     "path": "marker.txt",
     "base64": "TUNQSFVCLVRFU1QtTUFSS0VSCnBsYWluIHRleHQgZml4dHVyZSBmb3IgdGhlIHlhcmEgc21va2UgdGVzdAo="
