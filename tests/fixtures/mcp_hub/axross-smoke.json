    "sql_enumerate"
   ],
   "network": "full",
   "target": "web",
   "call": {
    "tool": "sql_test",
    "args": {
     "target": "http://${TARGET_HOST}:${TARGET_PORT}/item?id=1",
     "param": "id"
    },
    "expect_substring": "\"injectable\": true"
   },
   "refused": {
