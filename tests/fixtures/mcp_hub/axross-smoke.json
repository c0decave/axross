   ],
   "files": [
    {
     "target": "/work",
     "path": "disk.img",
     "base64": "",
     "gzip": true
    }
   ],
   "network": "none",
   "call": {
    "tool": "read_file",
    "args": {
     "image": "/work/disk.img",
     "inode": "5"
    },
    "expect_substring": "MCPHUB-TEST-MARKER deleted file"
   },
   "refused": {
    "tool": "read_file",
    "args": {
     "image": "/work/disk.img",
     "inode": "4; id"
