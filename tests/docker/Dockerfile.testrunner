FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        rsync \
        netcat-openbsd \
        nfs-common \
        open-iscsi \
        util-linux \
        kmod \
        procps \
        libglib2.0-0 \
        libgl1 \
        libegl1 \
        libfontconfig1 \
        libxkbcommon0 \
        libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*

ENV QT_QPA_PLATFORM=offscreen

RUN pip install --no-cache-dir \
        paramiko PySocks smbprotocol webdavclient3 boto3 pytest \
        defusedxml keyring PyQt6 azure-storage-blob azure-storage-file-share \
        msal requests google-api-python-client google-auth-oauthlib \
        google-auth-httplib2 dropbox adb-shell py7zr tftpy psycopg[binary] \
        redis pymongo dulwich fusepy pywinrm impacket exchangelib dnspython \
        puremagic chardet pysnmp ldap3 manuf ipwhois ntplib

COPY . /app/

# Default: drop into a shell so operators can run pytest subsets interactively
# (`docker compose run --rm test-runner pytest tests/test_protocols.py -k nfs`).
CMD ["bash"]
