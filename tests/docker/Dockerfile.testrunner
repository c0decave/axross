# Containerised test runner for the axross suite.
#
# Build/run via podman (rootless, disposable) — see
# tests/docker/TESTENV.md. The image carries every optional backend
# dependency so no test silently skips for a missing import.
#
# Dependency source of truth is pyproject.toml, NOT a hand-kept pip
# list. The previous revision of this file hard-coded its own package
# list and drifted from the project metadata: it installed
# `webdavclient3` (dropped upstream — axross ships its own WebDAV
# client on requests+defusedxml) while missing `Pillow` (a *core*
# runtime dep since the preview pane landed) and `rarfile`. Tests that
# import those degraded to skips, so the suite reported green on an
# environment that could not exercise them. Deriving the list from
# pyproject at build time makes that class of drift impossible.

# The rsh backend shells out to the system `rsh` client. Debian dropped
# every rsh client after bullseye (trixie has neither rsh-client nor
# rsh-redone-client), so the client comes from bullseye, now served by
# archive.debian.org. rsh-redone-rsh links against libc only.
FROM docker.io/library/debian:bullseye-slim AS rsh-client
RUN printf 'deb http://archive.debian.org/debian bullseye main\n' > /etc/apt/sources.list \
 && rm -f /etc/apt/sources.list.d/* \
 && apt-get -o Acquire::Check-Valid-Until=false update \
 && apt-get install -y --no-install-recommends rsh-redone-client \
 && rm -rf /var/lib/apt/lists/*

FROM docker.io/library/python:3.12-slim

WORKDIR /app

# Runtime libs:
#   - Qt6 offscreen platform plugin needs GL/EGL, glib, fontconfig,
#     xkbcommon and dbus even when it never opens a window.
#   - libarchive-tools provides bsdtar, which `rarfile` shells out to
#     for RAR extraction (tests/test_archive_rar_safety.py).
#   - binutils provides `strings`, which tests/test_packaging.py uses to
#     scan bundled binaries. Without it those tests skip, so the bundle
#     import-presence coverage would quietly disappear in the container.
#   - rsync/netcat/nfs-common/open-iscsi back the protocol tests that
#     talk to the lab containers in docker-compose.yml.
#   - subversion provides `svn`, which the SVN backend shells out to
#     (tests against the lab svn-server and svn.apache.org).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        binutils \
        rsync \
        subversion \
        netcat-openbsd \
        nfs-common \
        open-iscsi \
        util-linux \
        kmod \
        procps \
        libarchive-tools \
        libglib2.0-0 \
        libgl1 \
        libegl1 \
        libfontconfig1 \
        libxkbcommon0 \
        libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*

ENV QT_QPA_PLATFORM=offscreen \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

# --- dependency layer -------------------------------------------------
# Only pyproject.toml and the derivation script are copied here so that
# source-only edits reuse this (slow) layer. Deps are read out of the
# same [project] tables the published wheel uses, with every optional
# extra enabled - except packages not published on PyPI (the sift extra):
# pip cannot resolve those, and a squatted name would install a
# stranger's package. See tests/docker/testrunner_requirements.py.
COPY pyproject.toml ./
COPY tests/docker/testrunner_requirements.py /tmp/testrunner_requirements.py
RUN python /tmp/testrunner_requirements.py pyproject.toml > /tmp/requirements.txt
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r /tmp/requirements.txt

# Test tooling in its own layer so adding a tool does not re-resolve the
# ~130-package dependency set above.
#
# pytest-timeout is not optional here: several protocol tests retry with
# a sleep-backoff loop, so an unreachable endpoint turns into a silent
# multi-minute hang instead of a failure. A hard per-test cap makes the
# suite terminate with a traceback pointing at the offender.
RUN python -m pip install --no-cache-dir pytest pytest-timeout pip-audit ruff

# The rsh client (see the rsh-client stage above); after the slow layers
# so adding it does not invalidate their cache.
COPY --from=rsh-client /usr/bin/rsh-redone-rsh /usr/local/bin/rsh

# --- source layer -----------------------------------------------------
COPY . /app/

# `--no-deps`: everything is already resolved above; this step only
# registers the project so `import axross` and the console script work.
RUN python -m pip install --no-cache-dir --no-deps -e .

# Default: drop into a shell so operators can run pytest subsets
# interactively
# (`podman run --rm -it axross-testrunner pytest tests/test_protocols.py -k nfs`).
CMD ["bash"]
