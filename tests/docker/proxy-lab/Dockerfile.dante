# SOCKS4 / SOCKS5 for the proxy lab: one instance without authentication
# (1080) and one with username/password (1081, system account).
FROM docker.io/library/alpine:3.20
RUN apk add --no-cache dante-server && \
    adduser -D -s /sbin/nologin proxyuser && \
    echo "proxyuser:proxypass" | chpasswd
COPY sockd-open.conf sockd-auth.conf entrypoint-dante.sh /etc/
RUN chmod 0755 /etc/entrypoint-dante.sh
EXPOSE 1080 1081
CMD ["/etc/entrypoint-dante.sh"]
