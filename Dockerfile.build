# Cross-distro build image for axross one-file bundles.
#
# PyInstaller ELFs dynamically link against the glibc of the
# BUILD host. A binary built on Arch (glibc 2.43) fails to start
# on Ubuntu 22.04 LTS (glibc 2.35) with a ``GLIBC_2.43 not found``
# ImportError. The fix is "build on the oldest glibc you want to
# support, not the newest".
#
# Base choice: almalinux:9 (glibc 2.34).
#
# Why not quay.io/pypa/manylinux_2_34_x86_64? The pypa manylinux
# images ship a STATIC-LINKED CPython at /opt/python, which
# PyInstaller refuses to bundle ("Python was built without a
# shared library"). AlmaLinux 9's distro python3.12 package is
# shared-library, same glibc floor (2.34), same PyQt6-wheel
# compatibility (manylinux_2_34 tag).
#
# Why not Debian bullseye (glibc 2.31)? PyQt6 only ships
# manylinux_2_34 wheels (verified on PyPI 2026-04). On glibc 2.31,
# pip refuses to install the wheel and falls back to a source
# build that requires the full Qt toolchain — impractical.
#
# glibc 2.34 target runs on:
#   Ubuntu 22.04+      (glibc 2.35)
#   Debian 12+         (glibc 2.36)
#   RHEL 9+ / Alma 9   (glibc 2.34 — exact match)
#   Fedora 35+         (glibc 2.34+)
#   Arch / openSUSE Tumbleweed (rolling, 2.34+)
#
# Does NOT cover Ubuntu 20.04 (glibc 2.31) or RHEL 8 (glibc 2.28).
#
# Build + run via scripts/build_bundle_docker.sh — don't invoke
# this Dockerfile directly.

FROM almalinux:9

# System deps: python3.12 for the interpreter, binutils for
# PyInstaller's objcopy / strip calls on the bundled ELF, and
# glibc-devel so PyInstaller's bootloader can link against libc.
#
# The Qt runtime libraries are NOT optional at build time. PyQt6's
# extension modules link against libGL / libxkbcommon / fontconfig,
# so a bare image can import PyQt6.QtCore but dies on QtGui, QtWidgets
# and QtSvg with "libGL.so.1: cannot open shared object file". That
# tripped the REQUIRED_MODS pre-flight in scripts/build_bundle.sh and
# aborted every containerised build (exit 2) — which is why the
# shipped bundles had been produced on the developer's host instead,
# against glibc 2.43, and failed to start on any glibc < 2.43 target.
# PyInstaller also needs to actually IMPORT these modules to trace
# their dependencies, so the libs must be present, not just the .so
# files inside the wheel.
#
# fuse-libs is here for the same reason: fusepy resolves libfuse via
# ctypes at IMPORT time and raises "Unable to find libfuse" without it,
# which the flavor=full pre-flight rejects.
RUN dnf install -y \
        python3.12 python3.12-pip binutils glibc-devel \
        mesa-libGL mesa-libEGL \
        libxkbcommon libxkbcommon-x11 \
        fontconfig freetype \
        libX11 libXext libXrender dbus-libs \
        fuse-libs tar gzip \
    && dnf clean all

# ripgrep and fd for Find Files (axross-full; core/file_search.find_tool
# looks in bin/ of the bundle first). Static musl releases, pinned by
# version and SHA-256 - an archive whose checksum differs stops the build
# before tar opens it. Their licence files travel with them.
ARG RG_VERSION=15.2.0
ARG RG_SHA256=33e15bcf1624b25cdd2a55813a47a2f95dbe126268203e76aa6a585d1e7b149c
ARG FD_VERSION=10.5.0
ARG FD_SHA256=761c72dc8e120d85b22292063be8a796e2eeb20eb3e4f38b8fa2343ccf3514a7
RUN mkdir -p /opt/axross-bin/licenses && cd /tmp \
    && curl -fsSL -o rg.tar.gz "https://github.com/BurntSushi/ripgrep/releases/download/${RG_VERSION}/ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
    && echo "${RG_SHA256}  rg.tar.gz" | sha256sum -c - \
    && tar --no-same-owner -xzf rg.tar.gz \
    && install -m 0755 "ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl/rg" /opt/axross-bin/rg \
    && cp "ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl/LICENSE-MIT" /opt/axross-bin/licenses/ripgrep-LICENSE-MIT \
    && curl -fsSL -o fd.tar.gz "https://github.com/sharkdp/fd/releases/download/v${FD_VERSION}/fd-v${FD_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
    && echo "${FD_SHA256}  fd.tar.gz" | sha256sum -c - \
    && tar --no-same-owner -xzf fd.tar.gz \
    && install -m 0755 "fd-v${FD_VERSION}-x86_64-unknown-linux-musl/fd" /opt/axross-bin/fd \
    && cp "fd-v${FD_VERSION}-x86_64-unknown-linux-musl/LICENSE-MIT" /opt/axross-bin/licenses/fd-LICENSE-MIT \
    && rm -rf /tmp/rg.tar.gz /tmp/fd.tar.gz /tmp/ripgrep-* /tmp/fd-v* \
    && /opt/axross-bin/rg --version && /opt/axross-bin/fd --version
ENV AXROSS_BUNDLE_BIN=/opt/axross-bin

# Stable Python alias — the distro ships "python3.12" not "python".
ENV PATH="/usr/bin:${PATH}"
RUN ln -sf /usr/bin/python3.12 /usr/local/bin/python

WORKDIR /build

# Install Python-level deps in a dedicated layer so source-only
# changes don't bust this cache.
#
# Keep this list in lockstep with REQUIRED_MODS / FULL_MODS in
# scripts/build_bundle.sh — that script's pre-flight refuses to
# build if any of these are missing, so a drift here surfaces fast.
# webdavclient3 is intentionally NOT installed: axross now ships its
# own WebDAV client built on requests + defusedxml.
# Floors mirror pyproject.toml, which is audited against OSV by
# ``python -m security.dep_floor_audit``. Do not lower one here to
# "make the build work" — that reintroduces a known-vulnerable release
# into the shipped bundle, where users cannot upgrade it independently.
COPY pyproject.toml ./
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        "paramiko>=5.0,<6.0" "cryptography>=41" "jsonschema>=4.21" \
        "PySocks>=1.7" "Pillow>=12.3.0" \
        "smbprotocol>=1.13" "boto3>=1.28" \
        "requests>=2.33.0" "defusedxml>=0.7" \
        "azure-storage-blob>=12.19" "azure-storage-file-share>=12.15" \
        "msal>=1.26" \
        "google-api-python-client>=2.100" "google-auth-oauthlib>=1.1" \
        "google-auth-httplib2>=0.2" "dropbox>=12.0" \
        "pywinrm>=0.4" "impacket>=0.11" "exchangelib>=5.0" \
        "adb-shell>=0.4" "py7zr>=1.1.3" "rarfile>=4.0" "tftpy>=0.8" \
        "psycopg[binary]>=3.1" "redis>=5.0" "pymongo>=4.6.3" "dulwich>=1.2.5" \
        "dnspython>=2.6.1" "puremagic>=1.20" "chardet>=5.2" \
        "ldap3>=2.9" "ipwhois>=1.3" "ntplib>=0.4" "pysnmp>=6.2" "manuf>=1.1" \
        "pypdf>=6.18.1" "sift-summarizer>=0.1.95" "numpy>=2.0" \
        "piper-tts==1.8.0" "onnxruntime==1.31.0" "faster-whisper==1.2.1" "ctranslate2==4.8.3" \
        "PyQt6==6.10.2" "PyQt6-Qt6==6.10.2" "PyQt6_sip>=13.11" \
        "fusepy>=3.0" \
        "pyinstaller>=6.0" "keyring>=24.0" "SecretStorage>=3.3"

# Libraries Qt's plugins link against that PyInstaller can bundle only when
# it finds them here: whatever is missing in this image is left to the
# target system without a word (scripts/bundle_smoke.py --system-libs
# fails the build on it). libtiff.so.5 for the TIFF plugin (Arch and Fedora
# ship .so.6 only), the xcb-util family for the xcb platform plugin (not
# installed by default on Ubuntu or Debian: no window on X11), libXrandr
# for the FFmpeg media plugin, libatomic for QtPdf. A layer of its own after
# the pip layer, so adding to it does not rebuild the Python packages.
RUN dnf install -y \
        libtiff \
        xcb-util xcb-util-cursor xcb-util-wm xcb-util-image \
        xcb-util-keysyms xcb-util-renderutil \
        libXrandr libatomic \
    && dnf clean all

# Copy the application tree last so rebuilds on source changes
# skip the pip-install layer.
#
# This used to cherry-pick core/ ui/ models/ build/ main.py scripts/,
# which silently omitted resources/. build/axross.spec only bundles
# resources/{scripts,wordlists,logo,icons} when the directory EXISTS
# (os.path.isdir guard), so the container build produced a binary with
# no bundled scripts — the exact condition scripts/build_bundle.sh
# smoke-tests for and aborts on (exit 4). Copying the whole tree keeps
# the spec and the image from drifting apart again; .dockerignore is
# what keeps the context small (dist/, .venv/, .git/ … are excluded).
COPY . .

# Mark scripts as executable (COPY discards bit on some hosts).
RUN chmod +x scripts/build_bundle.sh

# Tell scripts/build_bundle.sh to use the distro interpreter
# instead of looking for a .venv (we installed deps globally).
ENV AXROSS_PYTHON="/usr/bin/python3.12"

# Default entrypoint builds whatever flavour is passed via CMD.
# scripts/build_bundle.sh writes to /build/dist/ inside the
# container; the wrapper script on the host ``docker cp``s the
# result out into the repo's dist/ dir.
ENTRYPOINT ["bash", "scripts/build_bundle.sh"]
CMD ["full"]
