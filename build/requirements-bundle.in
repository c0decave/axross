# --- outside pyproject: optional imports the Linux bundles carry -------------
# core/mcp_server.py validates MCP tool arguments with jsonschema when it is
# importable (it is not a pyproject dependency). The Linux builder has always
# installed it; the macOS / Windows CI bundles never had it.
jsonschema>=4.21 ; sys_platform == "linux"

# --- floors for transitive dependencies ------------------------------------
# Not imported by axross; adb-shell, impacket, ldap3, pysnmp and google-auth
# (via rsa, pyasn1-modules) pull it in. 0.6.5 fixes the decoder advisories
# of 0.6.4 (GHSA-2qm8-x737-gmw5, GHSA-fm9c-5rcf-2q5p, GHSA-mm57-4v3p-rchx,
# GHSA-9m75-vc3g-4x39); the floor keeps a refresh from going below it.
pyasn1>=0.6.5
