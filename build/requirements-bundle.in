# 1.2.1 fixes GHSA-9v8h-qqgm-4m35 of 1.2.0 (a reviewed young release).
brotli>=1.2.1 ; platform_python_implementation == "CPython"
brotlicffi>=1.2.1.0 ; platform_python_implementation == "PyPy"

