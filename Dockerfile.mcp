# Headless axross MCP server image.
#
# This image does NOT ship the PyQt6 GUI — it's purpose-built for
# running ``axross --mcp-server`` as a long-lived service behind a
# reverse proxy, in Kubernetes, or via docker-compose. Omitting Qt
# shaves ~250 MB off the final layer.
#
# Build:
#   docker build -f Dockerfile.mcp -t axross-headless-mcp:latest .
# Released as ghcr.io/c0decave/axross-headless-mcp:{VERSION,latest} by
# .github/workflows/mcp-release.yml on every release tag.
#
# Run (stdio, for manual testing):
#   docker run -i --rm axross-headless-mcp:latest --mcp-server
#
# Run (plain HTTP): plain HTTP is served on loopback only (0.0.0.0
# without TLS is refused), so it is reachable from the host only with
# the host's network:
#   docker run --network host -v /path/to/data:/data axross-headless-mcp:latest \
#       --mcp-server --mcp-root /data --mcp-http 127.0.0.1:7331
#
# Run (mTLS-protected HTTP, production shape):
#   docker run -p 7331:7331 \
#       -v $(pwd)/certs:/certs:ro \
#       -v /path/to/data:/data \
#       axross-headless-mcp:latest \
#       --mcp-server --mcp-write \
#       --mcp-http 0.0.0.0:7331 \
#       --mcp-cert /certs/server.pem \
#       --mcp-key /certs/server-key.pem \
#       --mcp-ca /certs/ca.pem
#
# NOTE: --mcp-write exposes mutating tools (write_file, mkdir,
# remove, rename, copy, chmod, symlink, hardlink, bulk_copy). The
# container's ``/data`` mount is the root the write operations are
# capped against — everything outside that path is refused by the
# MCP _enforce_root guard. Mount only what the client should be
# allowed to touch.

# The base image. The release workflow (.github/workflows/mcp-release.yml)
# resolves the tag to its digest when it builds and passes
# PYTHON_IMAGE=python:3.12-slim@sha256:<digest>, so the build uses exactly
# that image and the label org.opencontainers.image.base.digest names it.
# To pin by hand: docker buildx imagetools inspect python:3.12-slim
# (the "Digest:" line), then --build-arg PYTHON_IMAGE=python:3.12-slim@<it>.
ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE} AS build

WORKDIR /build
COPY pyproject.toml ./
# Everything main.py's MCP path imports, and the data it reads:
# axross/ (the version), core/, models/, security/ (core's protocol and
# path checks) and resources/ (interface catalogues, wordlists, the MCP
# catalog). No ui/: the GUI is not part of this image.
# tests/test_docker_images.py holds this list against the imports.
COPY axross/ axross/
COPY core/ core/
COPY models/ models/
COPY security/ security/
COPY resources/ resources/
COPY main.py ./

# Minimal runtime deps for the MCP surface — explicitly NO PyQt6,
# NO googleapiclient, NO dropbox, NO msal, NO exchangelib. The
# slim flavour of the main app covers the same subset; this
# container trims further because Qt is never needed. The floors are
# pyproject.toml's (security floors; tests/test_docker_images.py).
# The same requirements as the PyPI package axross-headless-mcp (its
# dependencies, then its extras smb, webdav, s3, adb, archive (7z) and
# images); tests/test_docker_images.py holds the two together.
RUN pip install --no-cache-dir \
        "paramiko>=5.0,<6.0" \
        "cryptography>=50.0.0" \
        "jsonschema>=4.21" \
        "keyring>=25.0" \
        "PySocks>=1.7" \
        "smbprotocol>=1.13" \
        "boto3>=1.28" \
        "requests>=2.33.0" \
        "defusedxml>=0.7" \
        "adb-shell>=0.4" \
        "py7zr>=1.1.3" \
        "Pillow>=13.0.0"

# ----------------------------------------------------------------------
# Final runtime image — copy over the interpreter + site-packages +
# our code, drop build tooling.
# ----------------------------------------------------------------------
ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE}

# The release workflow (.github/workflows/mcp-release.yml) passes the
# version of the tag; it is the image's version label.
ARG VERSION=dev
ARG BASE_DIGEST=unpinned
# The official MCP registry accepts this image as a package of the server
# io.github.c0decave/axross-headless-mcp (server.json) only when it carries this label.
LABEL io.modelcontextprotocol.server.name="io.github.c0decave/axross-headless-mcp" \
      org.opencontainers.image.title="axross-headless-mcp" \
      org.opencontainers.image.description="axross's headless MCP server: file tools for local and remote storage, no GUI" \
      org.opencontainers.image.source="https://github.com/c0decave/axross" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.base.name="python:3.12-slim" \
      org.opencontainers.image.base.digest="${BASE_DIGEST}"

# System tools the backends shell out to (rsync, iscsiadm, mount
# are NOT installed here because iSCSI / NFS aren't MCP-surface
# workloads). Keep the container small.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /usr/local/lib/python3.12/site-packages \
                  /usr/local/lib/python3.12/site-packages
COPY --from=build /build/axross /app/axross
COPY --from=build /build/core /app/core
COPY --from=build /build/models /app/models
COPY --from=build /build/security /app/security
COPY --from=build /build/resources /app/resources
COPY --from=build /build/main.py /app/main.py

WORKDIR /app

# Non-root user — write tools default to a chroot under /data so
# the MCP client can't wander outside what the operator mounted.
RUN useradd --create-home --shell /usr/sbin/nologin axross \
    && mkdir -p /data \
    && chown axross:axross /data

USER axross

# Default: stdio server — operator overrides with CMD args for
# --mcp-http / --mcp-write / cert paths.
ENTRYPOINT ["python", "/app/main.py"]
CMD ["--mcp-server"]

# Document the expected volume + port; operator still has to pass
# them on docker run.
VOLUME ["/data"]
EXPOSE 7331
